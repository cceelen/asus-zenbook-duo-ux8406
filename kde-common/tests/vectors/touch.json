[
  {
    "name": "the two touch controllers are found with their ids in small letters",
    "call": "controllersOf",
    "devices": [
      [
        "i2c-0",
        [
          "name",
          "subsystem"
        ]
      ],
      [
        "i2c-ELAN9008:00",
        [
          "0018:04F3:4447.0006",
          "driver",
          "modalias",
          "power"
        ]
      ],
      [
        "i2c-ELAN9009:00",
        [
          "0018:04F3:4448.0005",
          "driver",
          "modalias",
          "power"
        ]
      ],
      [
        "i2c-ASUE1234:00",
        [
          "0018:0B05:1234.0001",
          "driver"
        ]
      ]
    ],
    "expect": [
      {
        "controller": "ELAN9008",
        "id": "04f3:4447"
      },
      {
        "controller": "ELAN9009",
        "id": "04f3:4448"
      }
    ]
  },
