# Which parts are built and installed.
option('screen', type: 'boolean', value: true,
       description: 'second-screen: second screen off while the keyboard lies on it')
option('guard', type: 'boolean', value: true,
       description: 'tcc-guard: CPU thermal-offset guard for the EC thermal warning')
option('keyboard', type: 'boolean', value: true,
       description: 'keyboard-bpf and keyboard-state: HID-BPF program for the keyboard, and the helper that keeps its state')
option('gnome', type: 'boolean', value: true,
       description: 'gnome-keys: GNOME Shell extension for the two display keys')
option('rotation', type: 'boolean', value: true,
       description: 'gnome-rotation: GNOME Shell extension that turns the built-in panels')
option('kde_shortcuts', type: 'boolean', value: true,
       description: 'kde-shortcuts: default KDE Plasma shortcuts for function keys')
option('kde', type: 'boolean', value: true,
       description: 'kde-keys: KDE Plasma program and KWin script for the two display keys and the touchscreens')
option('kde_rotation', type: 'boolean', value: true,
       description: 'kde-rotation: KDE Plasma program and tray applet that turn the built-in panels')

# How the guard is started.
option('init', type: 'combo', choices: ['systemd', 'openrc'], value: 'systemd',
       description: 'Install the guard with a systemd unit or with an OpenRC script')

# Where things go, beyond what Meson knows (prefix, libexecdir, sbindir,
# datadir, licensedir). Empty: asked from pkg-config where it knows, else below prefix.
option('udevdir', type: 'string', value: '',
       description: 'udev directory (rules.d, hwdb.d) [pkg-config udev, or PREFIX/lib/udev]')
option('systemdsystemunitdir', type: 'string', value: '',
       description: 'systemd system units [pkg-config systemd, or PREFIX/lib/systemd/system]')
option('firmwaredir', type: 'string', value: '',
       description: 'firmware directory, for hid/bpf [PREFIX/lib/firmware]')
option('initddir', type: 'string', value: '/etc/init.d',
       description: 'OpenRC scripts')

# Cargo may not use the network. auto: not if the tree carries the crates in
# vendor/, as a source archive from `meson dist` does.
option('offline', type: 'feature', value: 'auto',
       description: 'Build the Rust programs without network access')

# systemd-analyze on the unit of the guard: verify, and an exposure of at
# most 1.3 (security). Off by default: the score differs between versions of
# systemd, and the builders of the distributions run the tests too.
option('unit_checks', type: 'feature', value: 'disabled',
       description: 'Check the systemd unit of the guard with systemd-analyze')

# The sanitizers, the coverage and the mutants of the HID-BPF program. Off by
# default: they need clang with its sanitizer runtimes and the C library of the
# host, and llvm-cov, which the builders of the distributions do not all have.
option('host_checks', type: 'feature', value: 'disabled',
       description: 'Check the HID-BPF program on the host with sanitizers, coverage and mutants')

# The Rust tests of the parts (cargo test). Off by default: CI runs them, and
# the builds of the distribution packages do not compile the test crates.
option('cargo_tests', type: 'feature', value: 'disabled',
       description: 'Run the Rust tests of the parts with cargo test')
