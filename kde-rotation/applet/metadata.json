        "Name": "Auto-rotate",
        "Website": "https://github.com/cceelen/asus-zenbook-duo-ux8406"
    },
    "X-Plasma-API-Minimum-Version": "6.0",
    "X-Plasma-DBusActivationService": "io.github.cceelen.BuiltinScreenRotation",
