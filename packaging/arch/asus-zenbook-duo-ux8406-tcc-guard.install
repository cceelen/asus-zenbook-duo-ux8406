# The guard is the purpose of the package: enable it, and start it where
# systemd is running (not in a container or chroot).
post_install() {
  systemctl enable asus-ux8406-tcc-guard.service >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    systemctl start asus-ux8406-tcc-guard.service >/dev/null 2>&1 || true
  fi
}

# Stopping the service restores the thermal offset.
pre_remove() {
  if [ -d /run/systemd/system ]; then
    systemctl stop asus-ux8406-tcc-guard.service >/dev/null 2>&1 || true
  fi
  systemctl disable asus-ux8406-tcc-guard.service >/dev/null 2>&1 || true
}
